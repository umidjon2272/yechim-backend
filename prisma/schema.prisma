generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES
  SUPPORT
  INSTALLER
  DEVELOPER
  EMPLOYEE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String?        @unique
  username         String?        @unique
  phone            String?        @unique
  passwordHash     String
  role             Role           @default(EMPLOYEE)
  permissions      String[]       @default([])
  status           String         @default("active")
  isActive         Boolean        @default(true)
  avatarUrl        String?
  teamId           String?
  team             Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  partnerGroupId   String?
  partnerGroup     CustomerGroup? @relation("PartnerGroupUsers", fields: [partnerGroupId], references: [id], onDelete: SetNull)

  assignedCustomers  Customer[]     @relation("AssignedCustomers")
  installerCustomers Customer[]     @relation("CustomerInstallers")
  createdTasks       Task[]         @relation("CreatedTasks")
  assignedTasks      Task[]         @relation("AssignedTasks")
  sessions           UserSession[]
  activities         Activity[]     @relation("CreatedActivities")
  reminders          Reminder[]     @relation("AssignedReminders")
  createdReminders   Reminder[]     @relation("CreatedReminders")
  notifications      Notification[]
  deals              Deal[]         @relation("DealSeller")
  installations      Installation[]
  payments           Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([partnerGroupId])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  status      String   @default("active")
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pipeline {
  id        String     @id @default(cuid())
  name      String     @unique
  stages    Stage[]
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Stage {
  id         String     @id
  label      String
  order      Int
  isFinal    Boolean    @default(false)
  pipelineId String
  pipeline   Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  customers  Customer[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([pipelineId])
  @@index([pipelineId, order])
}

model Customer {
  id                  String          @id @default(cuid())
  name                String
  firstName           String?
  lastName            String?
  phone               String?         @unique
  phone2              String?
  telegram            String?
  email               String?         @unique
  service             String?
  amount              Decimal         @default(0)
  depositAmount       Decimal?
  notes               String?
  note                String?
  address             Json?
  latitude            Float?
  longitude           Float?
  birthDate           String?
  telegramUsername    String?
  instagram           String?
  source              String?
  customFields        Json?
  programs            Json?
  status              String          @default("active")
  pipelineId          String
  pipeline            Pipeline        @relation(fields: [pipelineId], references: [id])
  stageId             String
  stage               Stage           @relation(fields: [stageId], references: [id])
  assignedEmployeeId  String?
  assignedEmployee    User?           @relation("AssignedCustomers", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  nextContactAt       DateTime?
  lastContactAt       DateTime?
  stageEnteredAt      DateTime        @default(now())
  installationAt      DateTime?
  installerEmployeeId String?
  installerEmployee   User?           @relation("CustomerInstallers", fields: [installerEmployeeId], references: [id], onDelete: SetNull)
  groups              CustomerGroup[] @relation("CustomerGroups")
  partnerRewards      PartnerReward[]
  businesses          Business[]
  leads               Lead[]
  deals               Deal[]
  tasks               Task[]
  installations       Installation[]
  activities          Activity[]
  reminders           Reminder[]
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([stageId])
  @@index([pipelineId])
  @@index([assignedEmployeeId])
  @@index([nextContactAt])
  @@index([stageEnteredAt])
  @@index([installerEmployeeId])
  @@index([status])
  @@index([deletedAt])
}

model CustomerGroup {
  id                       String          @id @default(cuid())
  name                     String          @unique
  partnerRewardPerCustomer Decimal?
  customers                Customer[]      @relation("CustomerGroups")
  partnerUsers             User[]          @relation("PartnerGroupUsers")
  partnerRewards           PartnerReward[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

model PartnerReward {
  id          String        @id @default(cuid())
  groupId     String
  customerId  String
  period      String
  amount      Decimal
  completedAt DateTime      @default(now())
  group       CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // A customer can earn a partner reward only once for a group. `period`
  // remains the month in which that one reward was earned, so monthly history
  // is retained without allowing a second payout after leaving/re-entering the
  // final stage.
  @@unique([groupId, customerId])
  @@index([groupId, period])
}

model CustomerFieldDef {
  id        String   @id @default(cuid())
  label     String
  type      String
  options   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramCatalog {
  id          String   @id @default(cuid())
  name        String
  type        String?
  version     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Business {
  id                 String         @id @default(cuid())
  name               String
  businessType       String?
  phone              String?
  email              String?
  address            String?
  city               String?
  status             String         @default("active")
  notes              String?
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedEmployeeId String?
  deals              Deal[]
  leads              Lead[]
  installations      Installation[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([customerId])
  @@index([assignedEmployeeId])
}

model Lead {
  id                 String    @id @default(cuid())
  title              String
  source             String?
  interestLevel      String?
  need               String?
  interestedProduct  String?
  status             String    @default("NEW")
  expectedValue      Decimal   @default(0)
  nextFollowUpDate   String?
  notes              String?
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId         String?
  business           Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  assignedEmployeeId String?
  dealId             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerId])
  @@index([businessId])
  @@index([assignedEmployeeId])
}

model Deal {
  id                 String         @id @default(cuid())
  name               String
  stage              String         @default("NEW")
  value              Decimal        @default(0)
  paymentStatus      String         @default("PENDING")
  installationStatus String         @default("PENDING")
  expectedCloseDate  String?
  productsNote       String?
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId         String?
  business           Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  salesEmployeeId    String?
  salesEmployee      User?          @relation("DealSeller", fields: [salesEmployeeId], references: [id], onDelete: SetNull)
  items              DealItem[]
  payments           Payment[]
  installations      Installation[]
  tasks              Task[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([customerId])
  @@index([businessId])
  @@index([salesEmployeeId])
}

model DealItem {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product   String
  quantity  Int      @default(1)
  unitPrice Decimal  @default(0)
  discount  Decimal  @default(0)
  total     Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id         String   @id @default(cuid())
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  customerId String?
  businessId String?
  employeeId String?
  employee   User?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  amount     Decimal  @default(0)
  method     String   @default("CASH")
  status     String   @default("PAID")
  date       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dealId])
  @@index([customerId])
  @@index([businessId])
  @@index([employeeId])
}

model Installation {
  id                 String    @id @default(cuid())
  dealId             String?
  deal               Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId         String?
  business           Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  dealItemId         String?
  assignedEmployeeId String?
  assignedEmployee   User?     @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  address            String?
  scheduledDate      String?
  startedDate        String?
  completedDate      String?
  status             String    @default("SCHEDULED")
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([dealId])
  @@index([customerId])
  @@index([businessId])
  @@index([assignedEmployeeId])
}

model Task {
  id                 String       @id @default(cuid())
  title              String
  description        String?
  status             TaskStatus   @default(TODO)
  priority           TaskPriority @default(MEDIUM)
  dueDate            String?
  assignedToId       String?
  assignedEmployeeId String?
  assignedTo         User?        @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?        @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId         String?
  leadId             String?
  dealId             String?
  deal               Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  installationId     String?
  automationKey      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([customerId, automationKey])
  @@index([assignedToId])
  @@index([createdById])
  @@index([customerId])
  @@index([businessId])
  @@index([leadId])
  @@index([dealId])
  @@index([installationId])
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Activity {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String
  message     String
  metadata    Json?
  createdById String?
  createdBy   User?    @relation("CreatedActivities", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([type])
}

model Reminder {
  id             String         @id @default(cuid())
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?          @relation("AssignedReminders", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?          @relation("CreatedReminders", fields: [createdById], references: [id], onDelete: SetNull)
  type           String         @default("CALL")
  title          String
  remindAt       DateTime
  status         ReminderStatus @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  notification   Notification?

  @@index([assignedUserId, status, remindAt])
  @@index([customerId, status])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderId String?   @unique
  reminder   Reminder? @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  entityType String?
  entityId   String?
  createdAt  DateTime  @default(now())

  @@index([userId, isRead, createdAt])
}

model Message {
  id         String   @id @default(cuid())
  customerId String
  senderType String
  senderName String
  text       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}
