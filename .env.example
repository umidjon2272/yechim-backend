PORT=3000
NODE_ENV=development
# For Neon in production, use the pooled ("-pooler") host and size the pool
# for this long-running server (see README "Neon connection pooling").
# Example: postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
